# ==== SMTP transport ====
SMTP_HOST=
SMTP_PORT=587
# true for 465 (SSL), false for 587/25 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ==== App settings used by the API route ====
# e.g. "Acme <no-reply@yourdomain.com>"
FROM_EMAIL=
# Where you (admin) receive the full submission
ADMIN_EMAIL=
# Used in subject lines / thank-you email copy
BRAND_NAME=
